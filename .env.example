# Copy to .env for local runs. Never commit .env.
# In GitHub Actions these are provided as repository secrets instead.

# Hardcover GraphQL API bearer token (JWT). Get it from your Hardcover account
# settings -> "Hardcover API". Note: it expires yearly (resets Jan 1).
HARDCOVER_TOKEN=

# Google Books API key. Optional but recommended for quota. Create one at
# https://console.cloud.google.com/ -> enable "Books API" -> create API key.
GOOGLE_BOOKS_API_KEY=

# Resend API key. https://resend.com -> API Keys. For the MVP test sender,
# sign up for Resend with the same email you set as `email.to` in config.yaml.
RESEND_API_KEY=
