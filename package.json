{
  "name": "book-releases",
  "version": "0.1.0",
  "private": true,
  "description": "Personal book release tracker — daily cron that emails you about new/forthcoming titles from authors you follow.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/main.ts run",
    "dry-run": "tsx src/main.ts run --dry-run",
    "seed": "tsx src/main.ts run --seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "resend": "^4.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
